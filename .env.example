# ─────────────────────────────────────────────────────────────
#  GUVTC Digital Campus — environment variables
#  On Vercel: Project → Settings → Environment Variables
#  Locally:   copy this file to .env
# ─────────────────────────────────────────────────────────────

# Database (PostgreSQL). On Vercel, adding Neon from Storage fills this in automatically.
DATABASE_URL="postgresql://guvtc:guvtc@localhost:5432/guvtc"

# 32+ random characters — signs login sessions and file links. Keep it secret.
AUTH_SECRET="change-me-to-a-long-random-string-0123456789"

# Any secret phrase. Needed once to open /setup on a fresh Vercel deployment.
SETUP_CODE=

# Optional: your custom domain, e.g. https://www.guvtc.ac.zw (Vercel's own URL is used if empty)
APP_URL=

# Email (required before launch). Without it, emails are not delivered.
# Works with Resend (smtp.resend.com, user "resend"), Brevo, Gmail/Google Workspace (app password),
# Microsoft 365 or a government mail relay.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Protects /api/jobs (email retries, advert archiving). Vercel Cron sends it automatically.
CRON_SECRET=

# File storage. On Vercel, connecting a PRIVATE Blob store fills these in automatically.
# Leave empty locally to store files in STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=
STORAGE_DIR=./storage

# Only for the command-line production seed (npm run db:seed -- --production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMISSIONS_EMAIL=
